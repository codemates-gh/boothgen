# Example environment variables. Copy to .env and fill in real values.
# (Only newer settings are listed here so far; see .env for the full set.)

# Public r2.dev URL of the `genie-downloads` R2 bucket, no trailing slash.
# /downloads/print-box/<file> redirects to ${GENIE_DOWNLOADS_URL}/print-box/<file>
# (Genie print box installer + auto-update feed). Unset = those links return 404.
GENIE_DOWNLOADS_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

// One row per event: everything in the Genie EventBundle except the templates
model EventGenieSettings {
  id             String  @id @default(cuid())
  tenantId       String
  eventId        String  @unique
  timeZone       String  @default("America/New_York")
  // Genie on/off for this event; off hides it from iPads and the bundle returns 409
  enabled        Boolean @default(true)
  // Section follows the account's Genie defaults (false) or was customized for this event (true). Existing rows
  // default to custom so adding defaults never changes an event someone already set up.
  customTimeZone Boolean @default(true)
  customCapture  Boolean @default(true)
  customSharing  Boolean @default(true)
  customPrinting Boolean @default(true)

  // CaptureConfig
  shotCount                    Int     @default(3)
  initialCountdownSeconds      Int     @default(5)
  betweenShotsCountdownSeconds Int     @default(3)
  showPerShotPreview           Boolean @default(true)
  allowPerShotRetake           Boolean @default(true)
  perShotPreviewSeconds        Int     @default(2)
  allowReviewRetake            Boolean @default(false)
  retakesPerShot               Int     @default(1)
  idleTimeoutSeconds           Int     @default(60)

  // ProcessingStep[] applied to every photo before the guest's filter
  processing Json @default("[]")

  // FilterConfig
  guestFiltersEnabled Boolean @default(false)
  defaultFilterId     String  @default("original")
  filters             Json    @default("[{\"id\":\"original\",\"name\":\"Original\",\"steps\":[]}]")

  // SharingConfig (galleryUrl / sessionUrlTemplate are derived)
  smsEnabled     Boolean @default(true)
  emailEnabled   Boolean @default(true)
  qrEnabled      Boolean @default(true)
  guestLinkScope String  @default("own") // "own" | "all"
  smsBody        String
  emailSubject   String
  emailBody      String  @db.Text
  smsConsentText String

  // PrintingConfig
  printingEnabled    Boolean @default(true)
  printMaxCopies     Int     @default(4)
  printDefaultCopies Int     @default(1)

  // Devices that may run this event at once (slots claimed on first bundle download)
  maxDevices Int @default(2)

  // Increases whenever the bundle content changes; bundleHash is the hash it was computed from
  bundleVersion Int       @default(1)
  bundleHash    String?
  lockedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("event_genie_settings")
}

model GenieSession {

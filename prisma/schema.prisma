// Bug reports and suggestions from signed-in users, triaged by Super Admins (src/lib/reports)
model FeedbackReport {
  id             String   @id @default(cuid())
  number         Int      @unique @default(autoincrement())
  userId         String
  tenantId       String?
  type           String // bug | suggestion
  title          String
  area           String // see REPORT_AREAS
  severity       String? // bugs: blocker | major | minor | cosmetic
  deviceInfo     String?
  details        String   @db.Text
  attachments    Json     @default("[]") // [{ key, name, contentType, bytes }]
  // Captured automatically when the report is filed
  pageUrl        String?
  userAgent      String?
  appVersion     String?
  // Triage
  status         String   @default("new") // see REPORT_STATUSES
  priority       String? // P1 | P2 | P3
  fixedInVersion String?
  // "Already exists": how to get to the feature (steps, optional link to the BoothGen page)
  howToFind      String?  @db.Text
  howToFindUrl   String?
  // "Duplicate": the original report (its followers moved there)
  duplicateOfId  String?
  adminUnread    Boolean  @default(true)
  reporterUnread Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  notes       FeedbackNote[]
  followers   FeedbackFollower[]
  duplicateOf FeedbackReport?    @relation("FeedbackDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  FeedbackReport[]   @relation("FeedbackDuplicates")

  @@index([status])
  @@index([userId])
  @@map("feedback_reports")
}

model FeedbackNote {
  id        String   @id @default(cuid())
  reportId  String
  authorId  String?
  fromAdmin Boolean  @default(false)
  internal  Boolean  @default(false) // Super Admin only; never shown to the reporter
  body      String   @db.Text
  createdAt DateTime @default(now())

  report FeedbackReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@map("feedback_notes")
}

// "This is my issue too": users following someone else's report get its status / note updates
model FeedbackFollower {
  reportId  String
  userId    String
  unread    Boolean  @default(false)
  createdAt DateTime @default(now())

  report FeedbackReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reportId, userId])
  @@index([userId])
  @@map("feedback_followers")
}
